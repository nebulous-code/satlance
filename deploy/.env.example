# Sat 'Lance — signet soak configuration.
#
#   cp deploy/.env.example deploy/.env
#
# deploy/.env is gitignored because it holds your Zoho password. Never commit
# it, and never put credentials in the compose file itself.

# --- node ---------------------------------------------------------------
# Both required; no defaults. Use whichever node implementation you run.
# The datadir must match what your image expects — check its documentation,
# or `docker inspect` it. A mismatch is quiet rather than loud: the node
# writes its cookie somewhere the daemon is not looking, and init waits
# forever for a file that will never appear.
SIGNET_NODE_IMAGE=
SIGNET_NODE_DATADIR=

# --- ntfy ---------------------------------------------------------------
# Your real instance, so the soak proves an alarm reaches your phone.
# host.docker.internal resolves to the host gateway (see extra_hosts).
#
# If your ntfy runs auth-default-access: read-write (the default), the topic
# name IS the access control: anyone who knows it can read your alarms and
# publish fake ones. Generate a fresh unguessable topic and never commit it.
#
NTFY_URL=http://host.docker.internal:8888/REPLACE-WITH-YOUR-OWN-TOPIC
# Only needed if you later enable auth on that instance.
NTFY_TOKEN=

# --- email --------------------------------------------------------------
MAIL_FROM=
MAIL_TO=
# The escalation channel. Add 'heartbeat' if you want daily proof-of-life by
# email too; 'alarm,degraded' keeps the inbox for things that need you.
SMTP_TIERS=alarm,degraded

# Zoho credentials. Held ONLY by the relay container — the Sat 'Lance SMTP
# notifier never sees them and speaks unencrypted SMTP to the relay over the
# compose network. Use a Zoho app-specific password, not your account password.
ZOHO_USER=
ZOHO_PASS=
